<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <rect width="1200" height="630" fill="#0B0F17"/>
  <circle cx="600" cy="315" r="400" fill="url(#glow)" opacity="0.25"/>
  <defs>
    <radialGradient id="glow" cx="50%" cy="50%" r="50%">
      <stop offset="0%" stop-color="#F59E0B"/>
      <stop offset="100%" stop-color="#0B0F17" stop-opacity="0"/>
    </radialGradient>
    <linearGradient id="grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F59E0B"/>
      <stop offset="100%" stop-color="#EA580C"/>
    </linearGradient>
  </defs>
  <rect x="540" y="160" width="120" height="120" rx="28" fill="url(#grad)" />
  <text x="600" y="240" font-family="sans-serif" font-weight="900" font-size="52" fill="#0B0F17" text-anchor="middle">AWS</text>
  <text x="600" y="360" font-family="sans-serif" font-weight="800" font-size="56" fill="#F8FAFC" text-anchor="middle">Sipna AWS Club</text>
  <text x="600" y="420" font-family="sans-serif" font-weight="500" font-size="28" fill="#94A3B8" text-anchor="middle">Sipna College of Engineering &amp; Technology, Amravati</text>
  <rect x="440" y="470" width="320" height="44" rx="22" fill="#F59E0B" fill-opacity="0.1" stroke="#F59E0B" stroke-opacity="0.3" />
  <text x="600" y="498" font-family="sans-serif" font-weight="600" font-size="18" fill="#F59E0B" text-anchor="middle">OFFICIAL STUDENT COMMUNITY</text>
</svg>
